# Canonical public origin for og:url, og:image, <link rel="canonical">,
# the sitemap, and robots.txt. No trailing slash.
#
# Leave this UNSET on Vercel preview/branch deploys — the build falls back to
# the deployment's own *.vercel.app URL, which actually serves the build, so
# link previews and canonicals resolve correctly.
#
# SET this in Vercel -> Settings -> Environment Variables, scoped to
# Production, once DNS for the real domain points at this project:
#   NEXT_PUBLIC_SITE_URL=https://www.americanairauthorities.com
#
# For local dev you can leave it unset (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
